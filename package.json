{
  "name": "@sudobility/building_blocks_rn",
  "version": "0.0.91",
  "description": "Higher-level shared UI building blocks for Sudobility React Native apps",
  "type": "module",
  "main": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./firebase": {
      "types": "./dist/firebase.d.ts",
      "react-native": "./dist/firebase.js",
      "import": "./dist/firebase.js",
      "default": "./dist/firebase.js"
    }
  },
  "files": [
    "dist",
    "ios",
    "macos",
    "windows",
    "react-native.config.cjs",
    "building_blocks_rn.podspec",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "lint": "eslint . --ext ts,tsx --ignore-pattern 'dist' --ignore-pattern 'node_modules' --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --ignore-pattern 'dist' --ignore-pattern 'node_modules' --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=4.0.0",
    "@react-navigation/native": ">=7.0.0",
    "@react-navigation/native-stack": ">=7.0.0",
    "@react-navigation/bottom-tabs": ">=7.0.0",
    "i18next": "^23.0.0 || ^24.0.0 || ^25.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "@sudobility/design": "^1.1.63",
    "react-native-localize": ">=3.0.0",
    "react-native-in-app-review": ">=4.4.2",
    "@sudobility/components-rn": "^1.0.126"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react-native-purchases": {
      "optional": true
    },
    "react-native-localize": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "@sudobility/types": {
      "optional": true
    },
    "react-native-in-app-review": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "~7.21.0",
    "@react-navigation/native": "~7.5.1",
    "@react-navigation/native-stack": "~7.21.0",
    "@sudobility/components-rn": "^1.0.126",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": "~5.104.5",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "i18next": "~25.10.10",
    "jsdom": "~28.1.0",
    "prettier": "3.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "~16.6.6",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "typescript": "~5.9.2",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/building_blocks_rn.git"
  }
}
